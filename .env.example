# =============================================================================
# Projeto Maya – Environment Variables
# Copy this file to .env.local and fill in all values before running the app.
# Never commit .env.local to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from https://app.supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# PagBank
# Get your token from https://minhaconta.pagseguro.uol.com.br/minha-conta/dados-da-conta
# PAGBANK_ENVIRONMENT: "production" or "sandbox"
# PAGBANK_WEBHOOK_TOKEN: any strong random string used to validate webhook signatures
# -----------------------------------------------------------------------------
PAGBANK_TOKEN=your-pagbank-token
PAGBANK_ENVIRONMENT=sandbox
PAGBANK_WEBHOOK_TOKEN=your-webhook-secret-token

# -----------------------------------------------------------------------------
# Application
# Public URL used to build absolute redirect/webhook URLs for PagBank.
# In Vercel set this to your production domain (e.g. https://projetomaya.org).
# Locally use http://localhost:3000.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Contato
# Número WhatsApp no formato internacional sem + (ex: 5519994128408)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=5519994128408

# -----------------------------------------------------------------------------
# Sentry (optional but recommended for production error monitoring)
# Create a project at https://sentry.io and grab the DSN from:
# Project Settings -> Client Keys (DSN)
# SENTRY_AUTH_TOKEN is only needed to upload source maps (CI/CD pipeline).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=projeto-maya
SENTRY_AUTH_TOKEN=sntrys_...

# -----------------------------------------------------------------------------
# Upstash Redis (optional — enables distributed rate limiting across all
# Vercel Edge instances; falls back to in-memory when absent)
# Create a Redis database at https://console.upstash.com and copy the values
# from "REST API" section.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=A...
